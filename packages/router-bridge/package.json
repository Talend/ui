{
  "name": "@talend/router-bridge",
  "version": "3.1.5",
  "description": "Bridge on top of cmf-router or react-router v5 + @talend/connected-react-router",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js"
    },
    "./lib/*": {
      "import": "./lib-esm/*",
      "require": "./lib/*"
    }
  },
  "scripts": {
    "build:lib": "talend-scripts build",
    "build:lib:esm": "talend-scripts build --esm",
    "build": "talend-scripts build",
    "oxlint:run": "oxlint --format=json > oxlint-report.json",
    "vitest:run": "vitest run",
    "vitest:update": "vitest run --update",
    "vitest:cov": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://ithub.com/Talend/ui.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ui/tree/master/packages/router-bridge#readme",
  "devDependencies": {
    "@talend/connected-react-router": "workspace:^",
    "@testing-library/react": "^14.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "peerDependencies": {
    "@talend/connected-react-router": "^6.9.3",
    "react-router": "^7.18.4"
  },
  "peerDependenciesMeta": {
    "@talend/connected-react-router": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
