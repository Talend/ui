{
  "name": "@talend/bootstrap-theme",
  "description": "Bootstrap theme based on Talend styleguide",
  "main": "dist/bootstrap.js",
  "mainSrc": "src/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "build:lib": "vite build",
    "start": "vite",
    "oxlint:run": "oxlint --format=json > oxlint-report.json",
    "stylelint:run": "stylelint --config .stylelintrc.js --formatter json -o stylelint-report.json 'src/**/*.{css,scss}'"
  },
  "keywords": [
    "talend",
    "theme",
    "bootstrap",
    "style"
  ],
  "author": "Talend Frontend <frontend@talend.com>",
  "homepage": "https://github.com/Talend/ui/tree/master/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/Talend/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Talend/ui.git"
  },
  "dependencies": {
    "@talend/bootstrap-sass": "workspace:^",
    "@talend/design-tokens": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "postcss": "^8.5.25",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.102.0",
    "vite": "^7.3.6"
  },
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "version": "10.1.4"
}
