{
  "name": "@talend/storybook-docs",
  "version": "3.1.4",
  "description": "Talend Storybook Docs component library",
  "main": "lib/index.js",
  "module": "./lib-esm/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build:styles": "rm -rf dist && mkdir -p dist && cp src/globalStyles.css dist/globalStyles.min.css && cp src/managerStyles.css dist/managerStyles.min.css",
    "build:lib": "talend-scripts build && npm run build:styles",
    "build:lib:esm": "talend-scripts build --esm",
    "start": "npm run storybook",
    "oxlint:run": "oxlint --format=json > oxlint-report.json",
    "stylelint:run": "stylelint --formatter json -o stylelint-report.json \"**/*.css\"",
    "storybook": "storybook dev -p 6106",
    "build-storybook": "storybook build --docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talend/ui.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Talend/ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.19.9",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@talend/design-tokens": "workspace:^",
    "algoliasearch": "^4.27.0",
    "classnames": "^2.5.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@figma/rest-api-spec": "^0.36.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^6.14.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "storybook": "^10.5.5",
    "sass": "^1.102.0",
    "sass-loader": "^14.2.1"
  }
}
