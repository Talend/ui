{
  "name": "@talend/connected-react-router",
  "version": "6.9.5",
  "description": "Fork of connected-react-router: a Redux binding for React Router v4 and v5",
  "main": "lib/index.js",
  "module": "lib-esm/index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js"
    },
    "./immutable": {
      "types": "./immutable.d.ts",
      "import": "./lib-esm/immutable.js",
      "require": "./lib/immutable.js"
    },
    "./seamless-immutable": {
      "types": "./seamless-immutable.d.ts",
      "import": "./lib-esm/seamless-immutable.js",
      "require": "./lib/seamless-immutable.js"
    },
    "./package.json": "./package.json"
  },
  "author": "Supasate Choochaisri",
  "license": "MIT",
  "files": [
    "*.md",
    "*.d.ts",
    "lib",
    "lib-esm"
  ],
  "scripts": {
    "build:lib": "talend-scripts build",
    "build:lib:esm": "talend-scripts build --esm",
    "oxlint:run": "oxlint --format=json > oxlint-report.json",
    "vitest:run": "vitest run",
    "vitest:cov": "vitest run --coverage",
    "vitest:update": "vitest run --update"
  },
  "dependencies": {
    "lodash.isequalwith": "^4.4.0",
    "prop-types": "^15.7.2"
  },
  "peerDependencies": {
    "history": "^4.7.2 || ^5.3.0",
    "react": "^16.4.0 || ^17.0.0 || ^18.3.1",
    "react-redux": "^6.0.0 || ^7.1.0",
    "react-router": "^4.3.1 || ^5.0.0 || ~6.3.0",
    "redux": "^3.6.0 || ^4.0.0"
  },
  "optionalDependencies": {
    "immutable": "^5.0.0",
    "seamless-immutable": "^7.1.3"
  },
  "devDependencies": {
    "@types/history": "^4.7.3",
    "@types/react": "*",
    "@types/react-redux": "^7.0.0",
    "@types/react-router": "^4.4.3",
    "enzyme": "3.1.1",
    "enzyme-adapter-react-16": "^1.0.4",
    "history": "^4.10.1",
    "jsdom": "^26.1.0",
    "immutable": "^5.1.5",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-redux": "^7.2.9",
    "react-router": "^5.3.4",
    "react-test-renderer": "^16.14.0",
    "redux": "^4.0.0",
    "redux-devtools": "^3.4.0",
    "redux-mock-store": "^1.2.1",
    "redux-seamless-immutable": "^0.4.0",
    "seamless-immutable": "^7.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Talend/ui.git",
    "directory": "fork/connected-react-router"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Talend/ui/issues"
  }
}
