{
  "scripts": {
    "build": "pnpm build:lib && pnpm build:lib:esm",
    "build:lib": "turbo run build:lib",
    "build:lib:esm": "turbo run build:lib:esm",
    "clean:build": "rimraf {packages,tools,fork}/*/{lib,lib-esm,dist}",
    "clean:demo": "rimraf {packages,tools,fork}/*/.storybook-static",
    "start": "pnpm --filter @talend/ui-playground run start",
    "release": "pnpm changeset publish",
    "lint-staged": "lint-staged",
    "oxlint:run": "turbo run oxlint:run --continue=always",
    "stylelint:run": "turbo run stylelint:run --continue=always",
    "vitest:run": "cross-env TZ=UTC turbo run vitest:run",
    "vitest:cov": "cross-env TZ=UTC turbo run vitest:cov",
    "vitest:update": "cross-env TZ=UTC pnpm -r --if-present --workspace-concurrency=1 run vitest:update",
    "storybook:build": "turbo run storybook:build",
    "storybook:start": "pnpm --filter @talend/ui-storybook-one run start",
    "storybook:start-components": "pnpm --filter @talend/react-components run start",
    "storybook:start-containers": "pnpm --filter @talend/react-containers run start",
    "storybook:start-dataviz": "pnpm --filter @talend/react-dataviz run start",
    "storybook:start-design-system": "pnpm --filter @talend/design-system run start",
    "storybook:start-stepper": "pnpm --filter @talend/react-stepper run start",
    "storybook:start-forms": "pnpm --filter @talend/react-forms run start",
    "storybook:start-theme": "pnpm --filter @talend/bootstrap-theme run start",
    "storybook:start-icons": "pnpm --filter @talend/icons run start-storybook",
    "test:cron": "pnpm -r --if-present --workspace-concurrency=1 run test:cron",
    "changelog": "git log --pretty=\"format:%C(bold green)%ad%C(reset) %s\" --date=short --color",
    "prepare": "husky install"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/cli": "^3.0.3",
    "@talend/locales-design-system": "^7.15.1",
    "@talend/locales-tui-components": "^16.0.1",
    "@talend/locales-tui-containers": "^9.1.3",
    "@talend/locales-tui-dataviz": "^3.0.1",
    "@talend/locales-tui-faceted-search": "^11.3.0",
    "@talend/locales-tui-forms": "^15.2.0",
    "@talend/scripts-cmf": "workspace:^",
    "@talend/scripts-config-babel": "workspace:^",
    "@talend/scripts-config-oxlint": "workspace:^",
    "@talend/scripts-config-prettier": "workspace:^",
    "@talend/scripts-config-storybook-lib": "workspace:^",
    "@talend/scripts-config-stylelint": "workspace:^",
    "@talend/scripts-config-typescript": "workspace:^",
    "@talend/scripts-core": "workspace:^",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.7",
    "cpx2": "^8.0.2",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "husky": "^8.0.3",
    "i18next-scanner": "^4.6.0",
    "jsdom": "26.1.0",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yarn-deduplicate": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Talend/ui.git"
  },
  "version": "0.0.0",
  "private": true,
  "lint-staged": {
    "*.{json,md,mdx,html,js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tar": "^7.5.22"
  }
}
